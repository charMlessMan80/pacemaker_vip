# Collections installées par ansible-galaxy (reconstruites depuis collections/requirements.yml)
/collections/ansible_collections/

# Fichiers de mot de passe Vault : ne jamais versionner
.vault_pass*
*.vault_pass
vault_password*

# Artefacts Ansible / outils
*.retry
.ansible/
__pycache__/
*.pyc

# Inventaires réels : TOUJOURS hors du dépôt (dépôt public, D26 ;
# CLAUDE.md §5 et §19). Seul le modèle inventories/example/ est versionné.
inventories/*
!inventories/example/
